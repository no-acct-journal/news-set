# Copy this file to .env for local development.
# Do not commit real credentials.

ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5433/news_set
APP_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
DATABASE_SCHEMA=public
SQLALCHEMY_ECHO=false

# Use REDIS_URL when your Redis provider gives you one.
# REDIS_URL=redis://:change-me@localhost:6379/0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=change-me
REDIS_SOCKET_TIMEOUT=5

# Optional AI chat backend proxy.
# Never put AI provider keys in frontend code.
AI_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# AI_API_KEY=change-me
AI_MODEL=qwen3-max-preview
AI_REQUEST_TIMEOUT=60
